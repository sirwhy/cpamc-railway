# ===================================================================
# Hermes Worker — environment file template.
# Copy to `.env` next to docker-compose.yml (or systemd EnvironmentFile)
# and fill in the values.
# ===================================================================

# Shared bearer token. Generate with:  openssl rand -hex 32
# This MUST match HERMES_WORKER_TOKEN configured on the Railway bot.
HERMES_AUTH_TOKEN=

# Storage root for jobs, voices, models, cache. Inside docker this is the
# /data volume (see docker-compose.yml). On bare-metal /var/lib/hermes is
# a sensible default.
HERMES_DATA_DIR=/data

# Concurrency cap. A single g4dn/g5 instance can comfortably run 1 job at
# a time (Demucs + Whisper + RVC are all GPU-hungry). Bump only if you
# have a beefier GPU.
HERMES_MAX_CONCURRENT_JOBS=1
HERMES_MAX_DURATION_SEC=600     # 10 min max song length
HERMES_MAX_FILE_SIZE_MB=100
HERMES_JOB_TTL_HOURS=24

# Models / pipeline tuning
HERMES_DEMUCS_MODEL=htdemucs_ft
HERMES_WHISPER_MODEL=large-v3
HERMES_WHISPER_DEVICE=cuda
HERMES_WHISPER_COMPUTE=float16
HERMES_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
HERMES_RVC_DEVICE=cuda:0
HERMES_TARGET_LUFS=-14

# Stage toggles — flip to false to disable a stage entirely (e.g. while
# debugging an install).
HERMES_ENABLE_XTTS=true
HERMES_ENABLE_RVC=true
HERMES_ENABLE_BASIC_PITCH=true
HERMES_ENABLE_TRANSLATION=true

# Translation backend (OpenAI-compatible chat completions). Required when
# HERMES_ENABLE_TRANSLATION=true. Defaults work with the official OpenAI
# API; point OPENAI_BASE_URL elsewhere for Together / Groq / etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HERMES_TRANSLATE_MODEL=gpt-4o-mini

# Server
HERMES_HOST=0.0.0.0
HERMES_PORT=8000
HERMES_LOG_LEVEL=info
